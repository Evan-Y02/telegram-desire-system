[Unit]
Description=Telegram Codex chat bridge
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__REPO__/telegram-bridge
Environment=HOME=__HOME__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TELEGRAM_DESIRE_CONFIG_DIR=__HOME__/.config/telegram-desire
ExecStart=/usr/bin/python3 -u __REPO__/telegram-bridge/chat.py
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=650
UMask=0077

[Install]
WantedBy=default.target
